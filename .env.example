# keen-pbr-tgbot — environment template
#
# Copy this file to .env and fill in real values. The .env file is
# gitignored — never commit real secrets.
#
#   cp .env.example .env
#   ${EDITOR:-vim} .env

# ---------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------
# Get from @BotFather: /newbot or /token
TGBOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN

# Comma-separated Telegram user IDs allowed to interact with the bot.
# Find your ID with @userinfobot or @getmyid_bot.
# Everyone else is silently ignored.
TGBOT_ADMIN_IDS=

# ---------------------------------------------------------------------
# forest-pbr REST API
# ---------------------------------------------------------------------
# Reachable URL of the forest-pbr daemon's REST API.
#   - On the same LAN as the router: http://192.168.1.1:12121
#   - Via Keenetic mDNS:             http://my.keenetic.net:12121
#   - Through a WireGuard tunnel:    http://<router-vpn-ip>:12121
FOREST_PBR_API_URL=http://192.168.1.1:12121

# HTTP timeout in seconds for calls to forest-pbr.
FOREST_PBR_TIMEOUT=10

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Where to persist bot state (FSM, rate-limit counters).
# Created on first run if missing. Outside the repo by convention.
BOT_STATE_DIR=./data
